{
  "meta": {
    "version": "1.0",
    "source": "Koltko-Rivera (2004). The psychology of worldviews. Review of General Psychology, 8(1), 3-58.",
    "scoring_schema": {
      "bipolar_dimensions": "Scored -2 to +2 where negative values indicate first pole, positive indicate second pole",
      "multi_option_dimensions": "Categorical labels or factor mappings as specified per dimension",
      "non_mutually_exclusive": "Marked dimensions where options are not opposites"
    }
  },

  "dimensions": {
    "HN-MO": {
      "name": "Moral Orientation",
      "group": "Human Nature",
      "poles": ["Good", "Evil"],
      "non_mutually_exclusive": true,
      "questions": {
        "HN-MO-1": { "A": 2, "B": 1, "C": 0, "D": -1, "E": -2 },
        "HN-MO-2": { "A": 2, "B": 1, "C": 0, "D": -1, "E": -2 },
        "HN-MO-3": { "A": 2, "B": 1, "C": 0, "D": -1, "E": -2 }
      },
      "interpretation": {
        "-2": "Humans are fundamentally good",
        "-1": "Humans lean toward good",
        "0": "Humans are morally mixed",
        "1": "Humans lean toward evil/self-interest",
        "2": "Humans are fundamentally evil/self-interested"
      }
    },

    "HN-MU": {
      "name": "Mutability",
      "group": "Human Nature",
      "poles": ["Changeable", "Permanent"],
      "non_mutually_exclusive": false,
      "questions": {
        "HN-MU-1": { "A": -2, "B": -1, "C": 0, "D": 1, "E": 2 },
        "HN-MU-2": { "A": -2, "B": -1, "C": 0, "D": 1, "E": 2 },
        "HN-MU-3": { "A": -2, "B": -1, "C": 0, "D": 1, "E": 2 }
      },
      "interpretation": {
        "-2": "Human nature is highly changeable",
        "-1": "Human nature can change significantly",
        "0": "Mixed view on changeability",
        "1": "Human nature is largely fixed",
        "2": "Human nature is permanent"
      }
    },

    "HN-CX": {
      "name": "Complexity",
      "group": "Human Nature",
