{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifs-active-inference.local/experiment51/configuration.schema.json",
  "title": "Experiment 51 configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "configuration_id",
    "initializer_id",
    "history_generator_id",
    "action_reconciler_id",
    "nodes",
    "edges",
    "observation_channels",
    "policy_families",
    "structure_candidates"
  ],
  "properties": {
    "contract_id": { "const": "ifs-ai-experiment-51-contract" },
    "contract_version": { "const": "1.0.1" },
    "configuration_id": { "$ref": "#/$defs/id" },
    "initializer_id": { "const": "neutral-replay-v1" },
    "history_generator_id": { "const": "world-replay-v1" },
    "action_reconciler_id": { "const": "plurality-safety-priority-v1" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/edge" }
    },
    "observation_channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/observation_channel" }
    },
    "policy_families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/policy_family" }
    },
    "structure_candidates": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/structure_candidate" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
      "maxLength": 64
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "cardinality", "slot", "active"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": [
            "BundleNode",
            "ContextNode",
            "CueNode",
            "LocalPrecisionNode",
            "GlobalPrecisionNode",
            "ProtectorNode",
            "PartnerNode",
            "AccessNode",
            "EpisodeNode",
            "StructureNode"
          ]
        },
        "cardinality": { "enum": [2, 3, 4, 5] },
        "slot": { "type": "integer", "minimum": 1, "maximum": 8 },
        "active": { "type": "boolean" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "from", "to", "state"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": [
            "bundle_context",
            "cue_root",
            "local_monitor",
            "local_to_global_broadcast",
            "global_precision_message",
            "protector_joint_policy",
            "protector_cross_prediction",
            "partner_regulation",
            "partner_trust",
            "policy_access",
            "access_bundle",
            "episode_scope",
            "structure_scope",
            "registration",
            "world_coupling"
          ]
        },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "state": { "enum": ["active", "inactive", "learnable"] }
      }
    },
    "discrete_channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "scope",
        "likelihood_family",
        "value_labels",
        "enabled"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source": {
          "enum": ["world", "body", "partner", "imaginal", "intervention"]
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "likelihood_family": {
          "enum": ["categorical", "bernoulli", "ordinal"]
        },
        "value_labels": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "enabled": { "type": "boolean" }
      }
    },
    "gaussian_channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "scope",
        "likelihood_family",
        "bounds",
        "enabled"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source": {
          "enum": ["world", "body", "partner", "imaginal", "intervention"]
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "likelihood_family": { "const": "gaussian_bounded" },
        "bounds": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": -1000000, "maximum": 1000000 },
            { "type": "number", "minimum": -1000000, "maximum": 1000000 }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "enabled": { "type": "boolean" }
      }
    },
    "observation_channel": {
      "oneOf": [
        { "$ref": "#/$defs/discrete_channel" },
        { "$ref": "#/$defs/gaussian_channel" }
      ]
    },
    "policy_family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "actor_nodes", "actions", "enabled"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "family": {
          "enum": [
            "contact",
            "avoidance",
            "inquiry",
            "support",
            "suppression",
            "observe"
          ]
        },
        "actor_nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "approach",
              "withdraw",
              "inspect",
              "request_support",
              "offer_support",
              "suppress",
              "permit",
              "wait",
              "observe"
            ]
          }
        },
        "enabled": { "const": true }
      }
    },
    "structure_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "structure_node",
        "family",
        "active_edges",
        "inactive_edges"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "structure_node": { "$ref": "#/$defs/id" },
        "family": {
          "enum": [
            "full_bundle",
            "reduced_bundle",
            "context_global",
            "context_cue_local",
            "context_split",
            "factorized_root",
            "shared_root"
          ]
        },
        "active_edges": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "inactive_edges": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
